@page "/GameEditor/{gameID:int}"
@* עמוד מארח שמאגד את עריכת השאלות ואת ההגדרות הכלליות תחת כתובת אחת עם טאבים *@
@attribute [Authorize]
@using AuthTemplate.Shared.Models
@inject HttpClient Http


@if (gameData != null && gameSettings != null)
{
    <div class="editor-header">
        @* שני הטאבים של מסך העריכה - בפריסת RTL האלמנט הראשון יושב בצד ימין *@
        <div class="editor-tabs">
            <button type="button" class="editor-tab  @settingsClass"
                    @onclick="@(() => SwitchTab("settings"))">
                ⚙️ הגדרות כלליות
            </button>
            <button type="button" class="editor-tab @questionsClass"
                    @onclick="@(() => SwitchTab("questions"))">
                ✏️ עריכת השאלות
            </button>
        </div>

        @* כפתור החזרה לטבלת המשחקים - יושב בפינה השמאלית *@
        <a class="back-pill" href="./GamesList">טבלת המשחקים <span class="back-arrow">←</span></a>
    </div>
    
    @* אזור הפרסום מוצג רק בטאב עריכת השאלות - בהגדרות הכלליות אין פרסום או סטטוס שמירה *@
    @if (activeTab == "questions")
    {
        <div class="publish-wrapper">
            <span class="publish-label">פרסום</span>
            <CustomPublishCheckbox CanPublish="gameSettings.canPublish"
                                   IsPublish="gameSettings.isPublish"
                                   OnPublishToggled="@((newState) => ChangePublishStatus(newState))"/>
        </div>
    }

    @* התוכן של הטאב הפעיל *@
    @if (activeTab == "questions")
    {
        <QuestionsEditor gameID="gameID" OnChangesSaved="ShowSavedMessage" gameData="gameData" />
    }
    else
    {
        <GeneralSettings gameID="gameID" OnSettingsSaved="SettingsSaved" gameSettings="gameSettings" />
    }

    @* כיתוב הסטטוס בתחתית המסך - רק בטאב עריכת השאלות *@
    @if (activeTab == "questions")
    {
        <p class="status-caption">@statusMessage</p>
    }
}
else if (!string.IsNullOrEmpty(errorMsg))
{
    <p style="color:red; text-align:center; padding: 20px;">שגיאה: @errorMsg</p>
}
else
{
    <p style="text-align:center; padding: 20px;">טוען נתונים...</p>
}

@code{ 
    // הפרמטר שמתקבל מהנתיב (מזהה המשחק)
    [Parameter] public int gameID { get; set; }

    // טאב פתיחה אופציונלי מכתובת ה-URL, למשל ?tab=settings אחרי יצירת משחק חדש
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string startTab { get; set; }

    // הטאב הפעיל כרגע - ברירת המחדל היא עריכת השאלות
    string activeTab = "questions";
    
    // הגדרות טאב פעיל לCSS 
    string settingsClass = "";
    string questionsClass = "active-tab";

    GameEditDto gameData;
    GameToAddDto gameSettings;
    string errorMsg = "";
    

    protected override async Task OnInitializedAsync()
    {
        // רק בכניסה לעמוד - בחירת הטאב לפי הכתובת (החלפות טאב בהמשך הן מקומיות בלבד)
        if (startTab == "settings")
        {
            SwitchTab("settings");
        }

        var qResponseTask = Http.GetAsync("api/Questions/getQuestions/" + gameID);
        var sResponseTask = Http.GetAsync("api/Games/byId/" + gameID);

        await Task.WhenAll(qResponseTask, sResponseTask);

        var qResponse = await qResponseTask;
        var sResponse = await sResponseTask;

        if (qResponse.IsSuccessStatusCode)
        {
            gameData = await qResponse.Content.ReadFromJsonAsync<GameEditDto>();
            
        }
        else
        {
            errorMsg = await qResponse.Content.ReadAsStringAsync();
        }

        if (sResponse.IsSuccessStatusCode)
        {
            gameSettings = await sResponse.Content.ReadFromJsonAsync<GameToAddDto>();
            
        }
        else
        {
            errorMsg = await sResponse.Content.ReadAsStringAsync();
        }
    }

    // החלפת טאב מקומית - הכתובת בדפדפן לא משתנה, כמו באפליקציית הייחוס
    void SwitchTab(string tabName)
    {
        activeTab = tabName;
        if (activeTab == "settings")
        {
            settingsClass = "active-tab";
            questionsClass = "";
        }
        else
        {
            settingsClass = "";
            questionsClass = "active-tab";
        }
    }

    // כיתוב ברירת המחדל בתחתית המסך
    const string autoSaveText = "השינויים נשמרים אוטומטית 💡";
    string statusMessage = "השינויים נשמרים אוטומטית 💡";

    // מציג את הודעת ההצלחה אחרי שמירה מוצלחת, ומחזיר את כיתוב ברירת המחדל אחרי כמה שניות
    async Task ShowSavedMessage()
    {
        //נעדכן את canPublish בכל שינוי שקורה
        var canPublishResponse = await Http.GetAsync("api/Games/checkCanPublish/" + gameID);
        gameSettings.canPublish = canPublishResponse.Content.ReadFromJsonAsync<bool>().Result;
        // נוודא שאם משחק היה מפורסם ואז המשחק כבר לא תקין, אז הisPublish המקומי צריך להתעדכן בהתאם, מונע בעיה שהצ'קבוקס "זוכרת" את המצב הישן של המשחק כמפורסם
        if (!gameSettings.canPublish && gameSettings.isPublish) 
        {
            gameSettings.isPublish = false;
        }
        statusMessage = "השינויים נשמרו בהצלחה ✨";
        StateHasChanged();

        await Task.Delay(4000);

        statusMessage = autoSaveText;
        StateHasChanged();
    }

    // אחרי שמירת ההגדרות - מציגים את ההודעה וחוזרים לטאב עריכת השאלות (כמו הניווט הישן)
    async Task SettingsSaved()
    {
        if (gameData != null && gameSettings != null)
        {
            gameData.gameName = gameSettings.gameName;
        }
        // מעבר דרך SwitchTab כדי שגם מחלקות העיצוב של הטאבים יתעדכנו ולא רק התוכן
        SwitchTab("questions");
    }
        
    async Task ChangePublishStatus(bool newState)
    {
        // בעת לחיצה על פרסום ניצור מופע של מחלקה עם מזהה המשחק ומצב הפרסום
        PublishGame gameToSend = new PublishGame();
        gameToSend.gameID = gameData.gameID;
        // נגדיר שמצב הפרסום הוא לפי הערך הבוליאני שהתקבל מהקומפוננטה
        gameToSend.isPublish = newState;
        // נשלח את המידע לקונטרולר
        var userRes = await Http.PostAsJsonAsync("api/Games/publishGame", gameToSend);
        // אם הכל תקין - נציג את מצב הפרסום העדכני
        //אם העדכון הצליח בבסיס הנתונים, שינוי מצב פרסום המשחק ברשימת המשחקים הקיימת בדף
        if (userRes.IsSuccessStatusCode == true)
        {
            gameSettings.isPublish = newState;
        }
        else
        {
            string error = userRes.Content.ReadAsStringAsync().Result;
        // אם נמצא בקונטרולר שמסיבה כלשהי טעינו ובעצם לא ניתן לפרסם את המשחק    
            if (error == "This game cannot be published")
            {
                // נשנה את מצב הפרסום ולא נאפשר לפרסם
                gameSettings.isPublish = false;
                // נסביר למשתמש מה קרה
                errorMsg = "המשחק אינו מאושר לפרסום";
            }
            else
            {
                // אחרת נקרא לפונקציית הודעות השגיאה אליה נוסיף את האופציות החדשות
                errorMsg = "error";
            }
        } 
    }
}
