@page "/"
@page "/{code:int}"

@if (loading)
{
    <p>המשחק נטען...</p>
}

<PageTitle>מְסַדְּרֵי המשי</PageTitle>

@* מחקנו את החלק שקשור לתצוגה שונה לפי משתמשים כי לא רלוונטי בהצגת משחק *@

<iframe width="1280" height="720" scrolling="no"
        src=@($"Game/index.html?code={code}") @onload="()=>loading=false"></iframe>

@code {

    [CascadingParameter]
    private User user { get; set; }
    [Parameter]
    public int code { get; set; }

    bool loading = true; 
}
