@inject IAuthenticationService _Auth

<AuthorizeView>
    <Authorized>
        <div class="navbar navbar-dark">

            <div class="container-fluid justify-content-start">
                @if (user != null)
                {
                    <div class="px-3">
                        <span class="oi oi-person ps-2"></span>@user.FirstName @user.LastName
                    </div>
                }
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true"></span> משחק
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="./GamesList">
                        <span aria-hidden="true"></span> המשחקים שלי
                    </NavLink>
                </div>
                <div class="nav-item">
                    <button class="nav-link popup-nav-btn" @onclick="() => showHowToPlay = true">איך משחקים?</button>
                </div>
                <div class="nav-item">
                    <button class="nav-link popup-nav-btn" @onclick="() => showAbout = true">אודות</button>
                </div>
                <div class="nav-item">
                    <button class="btn" @onclick="() => { _Auth.Logout(); }">התנתקות</button>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="navbar navbar-dark">
            <div class="container-fluid justify-content-start">
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true"></span> משחק
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="./GamesList">
                        <span aria-hidden="true"></span> המשחקים שלי
                    </NavLink>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (showHowToPlay == true)
{
    <InfoPopup PopupTitle="איך משחקים?" OnClose="() => showHowToPlay = false">
        <ol>
            <li>זזים</li>
            <li>אוכלים תותים</li>
            <li>מתמצאים</li>
        </ol>
    </InfoPopup>
}

@if (showAbout == true)
{
    <InfoPopup PopupTitle="אודות" OnClose="() => showAbout = false">
        <p>תוצר זה פותח במסגרת הפרויקט המשולש</p>
        <p>הפקולטה לטכנולוגיות למידה תשפ"ו</p>
    </InfoPopup>
}
@code {
    [CascadingParameter] private User user { get; set; }
    bool showHowToPlay = false;
    bool showAbout = false;
}