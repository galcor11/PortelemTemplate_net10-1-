@inject IAuthenticationService _Auth

<AuthorizeView>
    <Authorized>
        <div class="navbar navbar-dark">

            <div class="container-fluid justify-content-start">
                
                @* --- הלוגו  שלנו *@
                <img src="./png/SilkyLogo.png" alt="לוגו מְסַדְּרֵי המשי" class="navbar-logo" />
                @if (user != null)
                {
                    <div class="px-3">
                        <span class="oi oi-person ps-2"></span>@user.FirstName @user.LastName
                    </div>
                }
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true"></span> משחק
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="./GamesList">
                        <span aria-hidden="true"></span> המשחקים שלי
                    </NavLink>
                </div>
                <div class="nav-item">
                    <button class="nav-link popup-nav-btn" @onclick="() => showHowToPlay = true">איך משחקים?</button>
                </div>
                <div class="nav-item">
                    <button class="nav-link popup-nav-btn" @onclick="() => showAbout = true">אודות</button>
                </div>
                <div class="nav-item">
                    <button class="btn" @onclick="() => { _Auth.Logout(); }">התנתקות</button>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="navbar navbar-dark">
            <div class="container-fluid justify-content-start">
                <img src="./png/SilkyLogo.png" alt="לוגו מְסַדְּרֵי המשי" class="navbar-logo" />
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true"></span> משחק
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="./GamesList">
                        <span aria-hidden="true"></span> המשחקים שלי
                    </NavLink>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (showHowToPlay == true)
{
    <InfoPopup PopupTitle="איך משחקים?" OnClose="() => showHowToPlay = false">
        
        <div class="howto-steps-container">

            @* --- שלב 1 --- *@
            <div class="howto-step">
                <h3>זזים</h3>
                <iframe width="100%" height="220" src="https://www.youtube.com/embed/pMOSpW46JHM?si=8hR7rfebcmssdYIb" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>

            @* --- שלב 2 --- *@
            <div class="howto-step">
                <h3>אוכלים תותים</h3>
                <iframe width="100%" height="220" src="https://www.youtube.com/embed/ccyyBG1JTvs?si=CQShjQfVgxqqtr7H" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>

            @* --- שלב 3 --- *@
            <div class="howto-step">
                <h3>מתמצאים</h3>
                <iframe width="100%" height="220" src="https://www.youtube.com/embed/1_EOlzto55w?si=jo_nWnuF0PMiCMM6" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>

        </div>
       @* תותים ושיקויים *@
       <div class="strawberry-footer">
            
        <h2 class="strawberry-question">ומה קורה אם אכלתי תות לא בַּסֵּדר?</h2>

       <div class="potions-box">
           <div class="potions-text">
               <span class="potions-title">זה בְּסֵדֶר, לא נורא!</span>
               <span class="potions-subtitle">במשחקים מסוימים, יש 2 שיקויי הצלה</span>
           </div>
                
           <div class="potions-details">
               <div class="potion-item">
                   <span class="potion-label">מתחדשים בכל שאלה</span>
                   <img src="./svg/potion.svg" alt="שיקוי ירוק" class="potion-icon" />
               </div>
               <div class="potion-item">
                   <span class="potion-label">ניתנים אוטומטית בפסילה</span>
                   <img src="./svg/potion.svg" alt="שיקוי ירוק" class="potion-icon" />
               </div>
           </div>
       </div>
       </div>
      
    </InfoPopup>
}

@if (showAbout == true)
{
    <InfoPopup PopupTitle="מְסַדְּרֵי המשי" OnClose="() => showAbout = false">
        <div class="about-container">
            
            <p class="about-creators">אפיון ופיתוח: גל גרוסמן, אורי שריקי ואילן קמנקר</p>
            
            <div class="about-courses-header">
                <img src="./svg/sweetButterfly.svg" alt="פרפר" class="butterfly-icon" />
                <span>עבודת גמר זו נוצרה במסגרת הקורסים:</span>
            </div>

            <ul class="courses-list">
                <li>
                    <img src="./svg/strawberry.svg" alt="תות" class="bullet-icon" />
                    סביבות לימוד אינטראקטיביות 1+ 2
                </li>
                <li>
                    <img src="./svg/strawberry.svg" alt="תות" class="bullet-icon" />
                    תכנות 2
                </li>
                <li>
                    <img src="./svg/strawberry.svg" alt="תות" class="bullet-icon" />
                    תכנות אינטראקציה ואנימציה 1+ 2
                </li>
            </ul>

            <div class="about-footer">
                <p>תשפ״ו</p>
                <a href="https://www.hit.ac.il/academic/instructional-technologies/" target="_blank" class="faculty-text">הפקולטה לטכנולוגיות למידה</a>
            </div>

            <!-- הלוגו שבפינה הימנית התחתונה -->
            <img src="./svg/HitHolonLogo.svg" alt="לוגו המכון" class="hit-logo" />
            
        </div>
    </InfoPopup>
}
@code {
    [CascadingParameter] private User user { get; set; }
    bool showHowToPlay = false;
    bool showAbout = false;
}