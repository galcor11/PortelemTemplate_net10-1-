@inherits Microsoft.AspNetCore.Components.Forms.InputText

<span class="input-with-counter">
    <input @attributes="@AdditionalAttributes" class="@CssClass default-input" @bind="@CurrentValueAsString"  @bind:event="oninput" @onkeyup="countChars" maxlength="@maxLength" />
    @* ספירת תווים (מקסימום/נוכחי כדי שיקרא נכון בעברית) *@
    <span class="char-counter @counterClass">@maxLength.ToString()/@length.ToString()</span>
</span>


@code {
    // פרמטר לקבלת אורך מחרוזת מינימלי
    [Parameter]
    public int minLength { get; set; } = 1;
    // פרמטר לקבלת אורך מחרוזת שממנו המונה נצבע כתום (אזהרת התקרבות למקסימום)
    // אם לא הועבר ערך, ברירת המחדל היא שלושה תווים לפני המקסימום
    [Parameter]
    public int? midLength { get; set; }
    // פרמטר לקבלת אורך מחרוזת מקסימלי
    [Parameter]
    public int maxLength { get; set; } = 20;
    // הערך האפקטיבי של סף האזהרה - מה שהועבר בפרמטר, או המקסימום פחות 3
    int effectiveMidLength => midLength ?? maxLength - 3;
    // משתנה שיכיל את שם המחלקה של המונה - ירוק כשהאורך תקין, אדום כשלא
    string counterClass = "";
    // משתנה שיכיל את אורך המחרוזת
    int length = 0;

    // מעדכן את הספירה גם כשהתיבה נפתחת עם טקסט קיים (מצב עריכה)
    protected override void OnParametersSet()
    {
        countChars();
    }

    void countChars()
    {
        if (CurrentValueAsString != null)
        {
            length = CurrentValueAsString.Length;
            if (length >= minLength && length < effectiveMidLength)
            {
                counterClass = "good-counter";
            }
            else if (length >= effectiveMidLength && length < maxLength)
            {
                counterClass = "warning-counter";
            }
            else
            {
                counterClass = "danger-counter";
            }
        }
    }





}
