@using AuthTemplate.Shared.Models
@* קומפוננטה שפתחנו בשביל ליצור פופ-אפ גנרי למחיקה  *@

<div class="popup-overlay">
    <section class="popup-content">
        @*  האיקס מפעיל את פונקציית הביטול  *@
        <span class="close-x" @onclick="CancelDelete">✖</span>
        @* אזור הכותרת *@
        <div class="popup-header">
            <img src="./SVG/Stunned.svg" alt="תולעת המוּמה" class="worm-icon" />
            <h2>אוי לא!</h2>
        </div>
        
        @* לכאן ייכנס הטקסט הדינמי שנעביר מבחוץ בכל פעם *@
        <div class="popup-body">
            @ChildContent 
        </div>
        
        @* אנחנו משתמשים בקומפוננטת הכפתורים  *@
        <div class="popup-buttons">
            <MyButton ButtonText="מחיקה" 
                      ButtonStyle="primary" 
                      OnClickAction="ConfirmDelete" />
                      
            <MyButton ButtonText="ביטול" 
                      ButtonStyle="secondary" 
                      OnClickAction="CancelDelete" />
        </div>

    </section>
</div>

@code {
    //אנחנו משתמשים ב-CHILDCONTENT כדי להעביר תוכן שלם של HTML לתוך הקומפוננטה, כלומר תוכן מתחלף
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    // פעמון שמודיע לעמוד הראשי אם המשתמש אישר או ביטל
    [Parameter]
    public EventCallback<bool> OnUserConfirm { get; set; }

    private async Task ConfirmDelete()
    {
        await OnUserConfirm.InvokeAsync(true);
    }

    private async Task CancelDelete()
    {
        await OnUserConfirm.InvokeAsync(false);
    }
}