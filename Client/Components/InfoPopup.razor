@* קומפוננטה שפתחנו בשביל "אודות" ו-"איך משחקים" *@

<div class="popup-overlay">
    <section class="popup-content">

        @* אזור הכותרת: מכיל  את הכותרת הדינמית ואת האיקס לסגירה *@
        <div class="popup-header">
            <h2>@PopupTitle</h2>
            <span class="close-x" @onclick="ClosePopup">✖</span>
        </div>

        @* לכאן נכנס הטקסט הדינמי שנעביר מבחוץ בכל פעם*@
        <div class="popup-body">
            @ChildContent
        </div>

    </section>
</div>

@code
{
    //  פרמטר כדי לקבל את כותרת הפופ-אפ מבחוץ
    [Parameter]
    public string PopupTitle { get; set; }

   
    [Parameter]
    public RenderFragment ChildContent { get; set; }

   
    [Parameter]
    public EventCallback OnClose { get; set; }

    // הפונקציה שמופעלת בלחיצה על ה-X
    private async Task ClosePopup()
    {
        // מצלצלים בפעמון החוצה לעמוד הראשי 
        await OnClose.InvokeAsync();
    }  
    
}
