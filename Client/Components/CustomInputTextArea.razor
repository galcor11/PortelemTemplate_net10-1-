@inherits Microsoft.AspNetCore.Components.Forms.InputTextArea
@* אותה קומפוננטה כמו CustomInputText רק בתור אזור טקסט (textarea) *@
@* העוטף מקבל את המחלקה מבחוץ (למשל צורת התות) והמונה יושב בתוכו למטה *@

<div class="textarea-with-counter @CssClass">
    <textarea @attributes="@AdditionalAttributes" class="" @bind="@CurrentValueAsString" @bind:event="oninput" @onkeyup="countChars" maxlength="@maxLength"></textarea>
    @* ספירת תווים (מקסימום/נוכחי כדי שיקרא נכון בעברית). הצבע משתנה רק על הטקסט של המונה *@
    <span class="char-counter @counterClass">@maxLength.ToString()/@length.ToString()</span>
</div>


@code {
    // פרמטר לקבלת אורך מחרוזת מינימלי
    [Parameter]
    public int minLength { get; set; } = 1;
    // פרמטר לקבלת אורך מחרוזת שממנו המונה נצבע כתום (אזהרת התקרבות למקסימום)
    [Parameter]
    public int midLength { get; set; } = 17;
    // פרמטר לקבלת אורך מחרוזת מקסימלי
    [Parameter]
    public int maxLength { get; set; } = 20;
    // משתנה שיכיל את שם המחלקה של המונה - ירוק כשהאורך תקין, אדום כשלא
    string counterClass = "";
    // משתנה שיכיל את אורך המחרוזת
    int length = 0;

    // מעדכן את הספירה גם כשהתיבה נפתחת עם טקסט קיים (מצב עריכה)
    protected override void OnParametersSet()
    {
        countChars();
    }

    void countChars()
    {
        if (CurrentValueAsString != null)
        {
            length = CurrentValueAsString.Length;
            if (length >= minLength && length < midLength)
            {
                counterClass = "good-counter";
            }
            else if (length >= midLength && length < maxLength)
            {
                counterClass = "warning-counter";
            }
            else
            {
                counterClass = "danger-counter";
            }
        }
    }
}
