@* קומפוננטה שפתחנו לצורך העריכה של שורת השאלה/ ההנחיה *@
<div class="instruction-row-container">

    @if (isEditMode == false)
    {
        @* מצב תצוגה רגיל: אייקון עיפרון וטקסט  *@
        <EditIcon OnClick="EnterEditMode" />
        <span class="fixed-prefix">@FixedPrefix</span>
        <span>@InstructionText</span>
    }
    else
    {
        <span class="fixed-prefix">@FixedPrefix</span>
        @* מצב עריכה: תיבת טקסט + כפתורי אישור/ביטול *@
        <CustomInputText @bind-Value="tempText" class="edit-input" maxLength="20" midLength="17" minLength="1" />

        @* כפתור אישור ראשי *@
        <MyButton ButtonText="אישור" 
                  ButtonStyle="primary" 
                  OnClickAction="Save" />

        @* כפתור ביטול  משני *@
        <MyButton ButtonText="ביטול" 
                  ButtonStyle="secondary" 
                  OnClickAction="Cancel" />
    }

</div>
@code {
    [Parameter]
    public string InstructionText { get; set; } // ההנחיה הנוכחית שמגיעה מהקונטרולר

    [Parameter]
    public EventCallback<string> OnInstructionSaved { get; set; } // פעמון ששולח את הטקסט החדש החוצה

    [Parameter]
    public EventCallback<bool> OnEditModeChanged { get; set; } // פעמון שמדווח החוצה על כניסה/יציאה ממצב עריכה

    bool isEditMode = false;
    // הנחיה קבועה לתצוגה בלבד, לא נשמרת ב-DB
    const string FixedPrefix = "סדרו את התותים לפי:";
    string tempText = ""; // משתנה זמני לעריכה, כדי שלא נדרוס את הטקסט המקורי אם המשתמש לוחץ "ביטול"

    // מעבר למצב עריכה
    async Task EnterEditMode()
    {
        tempText = InstructionText; // מעתיקים את הטקסט הקיים לתוך תיבת העריכה
        isEditMode = true;
        await OnEditModeChanged.InvokeAsync(true); // מדווחים החוצה שנכנסנו לעריכה
    }

    // ביטול עריכה
    async Task Cancel()
    {
        isEditMode = false;
        await OnEditModeChanged.InvokeAsync(false); // מדווחים החוצה שיצאנו מעריכה
    }

    // אישור עריכה
    async Task Save()
    {
        isEditMode = false;
        await OnEditModeChanged.InvokeAsync(false); // מדווחים החוצה שיצאנו מעריכה
        await OnInstructionSaved.InvokeAsync(tempText); // צלצול בפעמון ושליחת הטקסט הֶחדש לעמוד הראשי
    }
}