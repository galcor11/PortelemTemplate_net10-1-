@* קומפוננטה שפתחנו למחיקה *@
@* אייקון פח לחיץ שקורא ישירות לפונקציה *@
<img src="./svg/deleteIcon.svg" class="delete-icon" alt="מחיקה" @onclick="IconClicked" />  
@code {
    // "פעמון" שמודיע לעמוד הראשי שלחצו על פח המחיקה
    [Parameter]
    public EventCallback OnClick { get; set; } 

    // הפונקציה שמופעלת בלחיצה על האייקון ומצלצלת בפעמון
    async Task IconClicked()
    {
        await OnClick.InvokeAsync();
    }
}