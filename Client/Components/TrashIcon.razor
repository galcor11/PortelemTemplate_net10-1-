@* קומפוננטה שפתחנו למחיקה *@
@* אייקון פח לחיץ  *@
<span class="delete-icon" @onclick="IconClicked">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="20" viewBox="0 0 18 20" fill="none">
        <path d="M5.44776 0V1.08955H0V3.26866H1.08955V17.4328C1.08955 18.0108 1.31914 18.565 1.7278 18.9737C2.13646 19.3824 2.69072 19.6119 3.26866 19.6119H14.1642C14.7421 19.6119 15.2964 19.3824 15.705 18.9737C16.1137 18.565 16.3433 18.0108 16.3433 17.4328V3.26866H17.4328V1.08955H11.9851V0H5.44776ZM3.26866 3.26866H14.1642V17.4328H3.26866V3.26866ZM5.44776 5.44776V15.2537H7.62687V5.44776H5.44776ZM9.80597 5.44776V15.2537H11.9851V5.44776H9.80597Z" fill="currentColor"/>
    </svg>
</span>

@code {
    // "פעמון" שמודיע לעמוד הראשי שלחצו על פח המחיקה
    [Parameter]
    public EventCallback OnClick { get; set; } 

    // הפונקציה שמופעלת בלחיצה על האייקון ומצלצלת בפעמון
    async Task IconClicked()
    {
        await OnClick.InvokeAsync();
    }
}