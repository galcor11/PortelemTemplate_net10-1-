@* קומפוננטת ההגדרות הכלליות - מוצגת בתור טאב בתוך העמוד המארח GameEditor *@
@* ההרשאות, קישור החזרה והטאבים נמצאים בעמוד המארח *@
@inject HttpClient Http
@using AuthTemplate.Shared.Models;
@inject NavigationManager Nav;

@* המכל הראשי שמכיל את הדשא *@
<div class="settings-page-wrapper">

    <h1 class="visually-hidden">️הגדרות כלליות️</h1>

    @* התנאי מופיע ומיד אחריו נפתחים הסוגריים המסולסלים *@
    @if (gameSettings != null)
    {
        @* דיב נוסף שמקבל עיצוב של שורה *@
        <div class="game-name-row">
        
            <label><span class="required-asterisk">*</span> שם המשחק:</label>
        
            <div>
                @* טקסט השם וכפתור עיפרון שפותח את הפופ-אפ של שם המשחק *@
                <span>@gameSettings.gameName</span>
                <input type="button" value="✏️" @onclick="() => showNamePopup = true" style="background: none; border: none; cursor: pointer;" />
            </div>
        
        </div>
    @* אזור הכרטיסים *@
    <div class="cards-container">

        @* כרטיס 1: זמן מענה *@
        <div class="setting-card">
            @* הכותרת והטולטיפ *@
            <div class="title-with-tooltip">
                <TooltipIcon ExplanationText="הזמן המוקצב לכל אחת מהשאלות שבמשחק" />
                <h2 class="card-title">זמן מענה לשאלה</h2>
            </div>
        
            <div class="input-row">
                @* הצ'קבוקס תמיד מוצג. אנחנו רוצים לתפוס את הרגע המדויק שבו המשתמש התחרט וביטל את הסימון של ללא הגבלה *@
                <div class="checkbox-wrapper">
                    <input type="checkbox" id="unlimited" checked="@isUnlimitedTime" @onchange="ToggleUnlimitedTime" />
                    <label for="unlimited">ללא הגבלה</label>
                </div>
                
                @* פקד מספר: מקושר לזמן, עם מינימום, מקסימום וקפיצות של 5. ננעל (disabled) אם סומן "ללא הגבלה" *@
                @* התנאי שבודק: אם לא סומן ללא הגבלה, רק אז נציג את תיבת המספר והמילה שניות *@
                <div style="visibility: @timeVisibility">
                <strong style="margin: 0 10px;">אוֹ</strong>
                <input type="number" 
                       @bind="gameSettings.time" 
                       min="45" max="180" step="5" 
                       class="time-input" />
                <span>שניות</span>
                </div>
            </div>
        </div>

         @* כרטיס 2: שיקוי הצלה *@
        <div class="setting-card potion-card-flex">
            
            @* אזור הכותרת הכולל קריאה לקומפוננטת טולטיפ והעברת טקסט ההסבר אליה כפרמטר *@
            <div class="title-with-tooltip" style="margin-bottom: 0;">
                <TooltipIcon ExplanationText="בסימון 'כן' השחקן יוכל להיפסל פעמיים ועדיין להמשיך במשחק" />
                <h2 class="card-title">שיקוי הצלה</h2>
            </div>  
            
            @* מכל הטוגל *@
            <div class="potion-toggle-container">
               
                <div class="potion-label">
                    
                    @* אזור בחירת ה"כן"  
                       שימוש בפונקציית חץ באירוע הלחיצה כדי להגדיר במפורש את המשתנה הבוליאני ל-true *@
                    <div class="@GetYesClass()" @onclick="() => gameSettings.hasPotion = true">
                        <img src="./svg/potion.svg" class="potion-img" aria-label="שיקוי הצלה מלא" alt=""/>
                        <span>כן</span>
                    </div>
                    <div class="@GetSliderClass()" @onclick="() => gameSettings.hasPotion = !gameSettings.hasPotion"></div>
                    
                    @* פקד הסליידר (המתג). מקבל את מחלקת האנימציה שלו (slider-on) מתוך הפונקציה. 
                    @* אזור בחירת ה"לא". 
                       שימוש בפונקציית חץ באירוע הלחיצה כדי להגדיר במפורש את המשתנה הבוליאני ל-false *@
                    <div class="@GetNoClass()" @onclick="() => gameSettings.hasPotion = false">
                        <img src="./svg/emptyPotion.svg" class="potion-img" aria-label="שיקוי הצלה רֵיק" alt=""/>
                        <span>לא</span>
                    </div>

                </div>
            </div>
        </div>

    </div>
       }    
else
{
    <p>טוען נתונים...</p>
}

<br />
@* כפתור השמירה שיפעיל את פונקציית העדכון מול הקונטרולר *@
<div style="width: max-content;">
    <MyButton ButtonStyle="primary" 
              ButtonText="לעריכת השאלות" 
              OnClickAction="SaveSettings" />
</div>
<p>@msg</p>
    <div class="worm-area" aria-hidden="true">
        <div class="speech-bubble">
            ההגדרות האלה יעזרו לי,<br/> והן לכל המשחק
        </div>
    @* הוספנו את התולעת והסתרנו מקוראי מסך לטובת נגישות *@
        <img src="SVG/SilkyForSettings.svg" class="worm-character" alt="" aria-hidden="true" />
    </div>
</div> <!-- סגירת העוטף הראשי של העמוד -->
@* פופ-אפ עריכת שם המשחק - נפתח בלחיצה על העיפרון, עם השם הנוכחי מוכן לעריכה *@

@if (showNamePopup)

{

    <AddGamePopup InitialName="@gameSettings.gameName" OnSave="SaveNewName" OnCancel="CloseNamePopup" />

}


@code
{
    //הפרמטר שמתקבל מהעמוד המארח
    [Parameter]
    public int gameID { get; set; }

    // פעמון שמדווח לעמוד המארח על שמירה מוצלחת של ההגדרות
    [Parameter] public EventCallback OnSettingsSaved { get; set; }
    
    // מופע של ה-DTO שמכיל את נתוני המשחק 
    [Parameter] public GameToAddDto gameSettings { get; set; }
    
    // משתנה בוליאני שעוזר לנו לבדוק אם אנחנו במצב עריכה או בתצוגה רגילה
    bool showNamePopup = false;
    //משתנה בוליאני שנועד לעזור לנו לאפשרות של בלי הגבלת זמן
    bool isUnlimitedTime = false;
    string timeVisibility = "visible";

    // עם טעינת העמוד
    protected override async Task OnInitializedAsync()
    {
        if (gameSettings == null)
        {
            // קריאה לקונטרולר שיביא את המשחק הספציפי
            var response = await Http.GetAsync("api/Games/byId/" + gameID.ToString());
            if (response.IsSuccessStatusCode == true)
            {
                gameSettings = response.Content.ReadFromJsonAsync<GameToAddDto>().Result;
            }
        }
        if (gameSettings != null)
        {
            isUnlimitedTime = (gameSettings.time == 1000);

            if (!isUnlimitedTime && gameSettings.time == null)
            {
                gameSettings.time = 60;
            }
        }
    }
    
    // נקרא כשהעורך מאשר בפופ-אפ: מעדכן רק את שם המשחק וסוגר את הפופ-אפ
    async void SaveNewName(GameToAddDto edited)
    {
        gameSettings.gameName = edited.gameName;
        showNamePopup = false;
        await SaveSettings();
    }

    // נקרא כשסוגרים/מבטלים את הפופ-אפ
    void CloseNamePopup()
    {
        showNamePopup = false;
    }
    
    // פונקציה שמופעלת כשהמשתמש לוחץ על הצ'קבוקס של "ללא הגבלה"
    void ToggleUnlimitedTime()
    {
        // תחילה, אנחנו הופכים את המצב של המשתנה הבוליאני (אם היה true הופך ל-false ולהפך)
        isUnlimitedTime = !isUnlimitedTime; 
        
        // אם המשתמש הרגע הוריד את ה-V (כלומר עכשיו יש הגבלת זמן), והזמן ששמור כרגע הוא 1000
        if (isUnlimitedTime == false && gameSettings.time == 1000)
        {
           // משנים את הזמן ל- 60 שניות, כדי שהוא לא ייבהל מהמספר 1000 שיופיע לו בתיבה 
            gameSettings.time = 60; 
        }

        if (isUnlimitedTime)
            timeVisibility = "hidden";
        else
            timeVisibility = "visible";

    }
    // פונקציה שמחזירה את מחלקת העיצוב לסליידר
    string GetSliderClass()
    {
        if (gameSettings.hasPotion == true) 
        {
            return "slider slider-on";
        }
        return "slider";
    }

    // פונקציה שמחזירה את מחלקת העיצוב לצד של ה"כן"
    string GetYesClass()
    {
        if (gameSettings.hasPotion == true) 
        {
            return "potion-option active";
        }
        return "potion-option";
    }

    // פונקציה שמחזירה את מחלקת העיצוב לצד של ה"לא"
    string GetNoClass()
    {
        if (gameSettings.hasPotion == false) 
        {
            return "potion-option active";
        }
        return "potion-option";
    }
    
    string msg = "";
    //פונקציה שפונה לקונטרולר שמעדכן את הפרטים שקשורים להגדרות הכלליות: שם המשחק, זמן, שיקוי
    async Task SaveSettings()
    {
        // בדיקה  אם המשתמש סימן ללא הגבלה, אנחנו מעדכנים ל-1000
        if (isUnlimitedTime == true)
        {
            gameSettings.time = 1000;
        }
        //  אם אין הגבלת זמן, אנחנו בודקים ומתקנים את מה שהוזן בתיבה
        else
        {
            // אם התיבה ריקה (null) או קטנה מ-45 או גדולה מ-180 -> מחזירים ל-60
            if (gameSettings.time == null || gameSettings.time < 45 || gameSettings.time > 180)
            {
                gameSettings.time = 60; 
            }
        }
        // שליחת בקשת POST לנתיב שיצרנו, תוך שרשור ה-ID ושליחת האובייקט המעודכן
        var updateResponse = await Http.PostAsJsonAsync("api/Games/updateGame/" + gameID.ToString(), gameSettings);
        
        // בדיקה אם העדכון הצליח        
        if (updateResponse.IsSuccessStatusCode == true)
        {
            // מדווחים לעמוד המארח - הוא יציג את ההודעה בתחתית ויעבור לטאב עריכת השאלות
            await OnSettingsSaved.InvokeAsync();
        }
        else 
        {
            // אם העדכון נכשל, נקרא את השגיאה שהשרת החזיר
            msg = updateResponse.Content.ReadAsStringAsync().Result;
        }
    } 
    
  }
