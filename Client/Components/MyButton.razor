@* קומפוננטה שפתחנו לכפתורים *@
@if (IsSubmit)
{
    @* כפתור טופס מסוג Submit - מפעיל את הוולידציות של הטופס לפני הפעלת הפונקציה *@
    <button type="submit" class="my-btn @ButtonStyle">
        @ButtonText
    </button>
}
else
{
    @* כפתור רגיל מסוג Button - מפעיל את פונקציית הלחיצה שהעברנו לו *@
    <button type="button" class="my-btn @ButtonStyle" @onclick="OnClickAction">
        @ButtonText
    </button>
}

@code {
    // הטקסט שמופיע על הכפתור
    [Parameter]
    public string ButtonText { get; set; }

    // סגנון הכפתור: מקבל את הערך "primary" או "secondary" או "disabled"
    [Parameter]
    public string ButtonStyle { get; set; } = "primary"; // primary ברירת המחדל

    // הפעמון שמפעיל את הפונקציה בעמוד הראשי כשלוחצים עליו
    [Parameter]
    public EventCallback OnClickAction { get; set; }
    
    // פרמטר שקובע אם הכפתור הוא כפתור שליחה של טופס. 
    [Parameter]
    public bool IsSubmit { get; set; } = false; 
}