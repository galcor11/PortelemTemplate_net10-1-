@* קומפוננטה שפתחנו בשביל האייקונים שבמצבי פרסום *@
<div class="tooltip-container @cursorClass">
    <span class="tooltip-text">@tooltipText</span>

    @* אנחנו קוראים לקומפוננטה הגנרית שלנו  *@
    <CustomCheckbox 
        IsChecked="IsPublish" 
        IsDisabled="!CanPublish" 
        OnToggled="HandleCheckboxToggled" />
</div>

@code {
    [Parameter] public bool CanPublish { get; set; }
    [Parameter] public bool IsPublish { get; set; }
    [Parameter] public EventCallback<bool> OnPublishToggled { get; set; }

    string cursorClass = "";
    string tooltipText = "";

    // פונקציה מובנית שרצה בכל פעם שהנתונים מהעמוד משתנים 
    protected override void OnParametersSet()
    {
        // 1. קביעת מחלקת סמן העכבר 
        if (CanPublish == false)
        {
            cursorClass = "cursor-blocked";
        }
        else
        {
            cursorClass = "cursor-pointer";
        }

        // קביעת הטקסט של הטולטיפ
        if (CanPublish == false)
        {
            tooltipText = "המשחק אינו עומד בתנאי הפרסום. יש ליצור לפחות 3 שאלות תַּקינות";
        }
        else if (IsPublish == true)
        {
            tooltipText = "לחיצה על המשבצת תוריד את המשחק מפרסום";
        }
        else
        {
            tooltipText = "לחיצה על המשבצת תפרסם את המשחק";
        }
    }

    // הפונקציה שמקבלת את הלחיצה מהצ'קבוקס הגנרי ומעבירה אותה לעמוד הראשי
    private async Task HandleCheckboxToggled(bool newState)
    {
        await OnPublishToggled.InvokeAsync(newState);
    }
}